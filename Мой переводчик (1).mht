<!DOCTYPE html><html lang="ru"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Мой переводчик</title>
  <link rel="stylesheet" href="http://hRqHsGYCYmtUzfv:OSrSL6FwtDkc2Ca@localhost:16432/storage/emulated/0/%D1%81%D1%80%D0%B0%D0%B2%D0%BD%D0%B8%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5%20%D0%BF%D1%80%D0%B8%D0%BB%D0%BE%D0%B6%D0%B5%D0%BD%D0%B8%D1%8F%20/%D0%BF%D0%B5%D1%80%D0%B5%D0%B2%D0%BE%D0%B4%D1%87%D0%B8%D0%BA.css">
</head>
<body>
  <main class="app">
    <h1>🌍 Переводчик</h1>
    <p class="subtitle">Переводи слова и предложения</p>

    <div class="languages">
      <select id="source">
        <option value="ru">Русский</option>
        <option value="en">Английский</option>
        <option value="ky">Кыргызский</option>
        <option value="tr">Турецкий</option>
        <option value="de">Немецкий</option>
        <option value="fr">Французский</option>
        <option value="es">Испанский</option>
        <option value="zh-CN">Китайский</option>
        <option value="ja">Японский</option>
      </select>

      <button id="swap" class="swap">⇄</button>

      <select id="target">
        <option value="en">Английский</option>
        <option value="ru">Русский</option>
        <option value="ky">Кыргызский</option>
        <option value="tr">Турецкий</option>
        <option value="de">Немецкий</option>
        <option value="fr">Французский</option>
        <option value="es">Испанский</option>
        <option value="zh-CN">Китайский</option>
        <option value="ja">Японский</option>
      </select>
    </div>

    <label for="inputText">Текст для перевода</label>
    <textarea id="inputText" placeholder="Напиши здесь текст..." maxlength="3000"></textarea>

    <button id="translate" class="translate">
      Перевести
    </button>

    <label for="outputText">Перевод</label>
    <textarea id="outputText" placeholder="Здесь появится перевод..." readonly=""></textarea>

    <div class="actions">
      <button id="copy">📋 Копировать</button>
      <button id="clear">🗑 Очистить</button>
    </div>

    <p id="status" role="status">Готов к переводу</p>
    <p class="footer">Мой первый проект ❤️</p>
  </main>

  

</body></html>
