@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; padding: 20px 12px; min-height: 100vh; font-family: Arial, sans-serif; background: linear-gradient(135deg, rgb(16, 23, 45), rgb(37, 61, 104)); color: white; }

.app { width: 100%; max-width: 500px; margin: 20px auto; padding: 22px; background: rgb(27, 39, 66); border-radius: 22px; box-shadow: rgba(0, 0, 0, 0.333) 0px 10px 35px; }

h1 { text-align: center; margin-bottom: 8px; }

.subtitle { text-align: center; color: rgb(185, 200, 230); margin-bottom: 25px; }

.languages { display: flex; align-items: center; gap: 8px; margin-bottom: 22px; }

select { width: 0px; flex: 1 1 0%; min-width: 0px; padding: 12px 4px; border: 1px solid rgb(82, 103, 137); border-radius: 10px; background: rgb(38, 56, 88); color: white; font-size: 14px; }

button { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 10px; padding: 13px; font-size: 15px; font-weight: bold; cursor: pointer; touch-action: manipulation; }

button:active { transform: scale(0.97); }

.swap { background: rgb(51, 73, 110); color: white; font-size: 22px; }

label { display: block; margin: 14px 0px 8px; color: rgb(219, 231, 255); font-weight: bold; }

textarea { display: block; width: 100%; height: 125px; resize: vertical; padding: 14px; border-radius: 12px; border: 1px solid rgb(82, 103, 137); background: rgb(17, 28, 50); color: white; font-size: 16px; line-height: 1.5; }

textarea::placeholder { color: rgb(135, 152, 184); }

.translate { width: 100%; margin: 18px 0px 10px; background: rgb(79, 131, 255); color: white; font-size: 17px; }

.translate:disabled { opacity: 0.6; }

#outputText { background: rgb(32, 47, 74); }

.actions { display: flex; gap: 10px; margin-top: 12px; }

.actions button { flex: 1 1 0%; background: rgb(51, 73, 110); color: white; }

#status { min-height: 20px; text-align: center; color: rgb(185, 208, 255); font-size: 14px; margin-top: 18px; overflow-wrap: anywhere; }

.footer { text-align: center; color: rgb(135, 152, 184); font-size: 13px; margin-bottom: 0px; }
